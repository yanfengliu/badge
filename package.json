{
  "name": "badge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate:archive-fixtures": "node scripts/generate-archive-fixtures.mjs",
    "generate:pack-fixtures": "node scripts/generate-pack-fixtures.mjs",
    "generate:fixtures": "npm run generate:archive-fixtures && npm run generate:pack-fixtures",
    "catalogue:prompts": "node scripts/print-catalogue-prompts.mjs",
    "catalogue:state-prompts": "node scripts/print-us-state-prompts.mjs",
    "catalogue:new-prompts": "node scripts/print-new-catalogue-prompts.mjs",
    "catalogue:new-correction-prompts": "node scripts/print-new-catalogue-correction-prompts.mjs",
    "catalogue:refresh-state-integrity": "node scripts/write-us-state-integrity.mjs",
    "catalogue:refresh-state-discovery": "node scripts/write-us-state-discovery-fixture.mjs",
    "catalogue:refresh-park-discovery": "node scripts/write-national-park-discovery-fixtures.mjs",
    "catalogue:refresh-new-discovery": "node scripts/write-new-discovery-fixtures.mjs",
    "catalogue:refresh-pack-fixtures": "node scripts/write-catalogue-pack-fixtures.mjs",
    "catalogue:thumbnails": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/write-national-park-thumbnails.ps1",
    "catalogue:refresh-integrity": "node scripts/write-national-park-integrity.mjs",
    "catalogue:refresh-discovery-manifest": "node scripts/write-discovery-thumbnail-manifest.mjs",
    "catalogue:refresh-source-manifest": "node scripts/write-discovery-source-manifest.mjs",
    "prestart": "npm run generate:fixtures",
    "start": "node scripts/run-local.mjs",
    "predev": "npm run generate:fixtures",
    "dev": "vite --config apps/host-web/vite.config.ts --host 127.0.0.1 --port 5173 --strictPort --mode fixture",
    "build": "npm run build:archive && npm run build:studio && npm run build:site",
    "prebuild:archive": "npm run generate:fixtures",
    "build:archive": "vite build --config apps/archive-web/vite.config.ts",
    "postbuild:archive": "node scripts/check-archive-bundle.mjs",
    "build:studio": "vite build --config apps/studio-web/vite.config.ts",
    "build:site": "vite build --config apps/host-web/vite.config.ts",
    "postbuild:site": "node scripts/check-host-build.mjs",
    "preview": "vite preview --config apps/host-web/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "precheck:local-startup": "npm run generate:fixtures",
    "check:local-startup": "node scripts/check-local-startup.mjs",
    "audit": "npm audit --audit-level=high",
    "audit:quotation-sources": "node scripts/audit-catalogue-quotation-sources.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:local-startup && npm run check:boundaries && npm run check:docs && npm run format:check && npm run audit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jsquash/webp": "1.5.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.11.6",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
